  "tasks": [
    {
      "label": "start-angular",
      "type": "npm",
      "script": "start",
      "path": "Web/WebUI",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://localhost:4200.*"
        }
      },
      "presentation": {
        "reveal": "always",
